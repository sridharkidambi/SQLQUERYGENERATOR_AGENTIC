# Copy to .env and fill in before running `docker compose up`.
# .env is read automatically by docker compose; do not commit the real one.

POSTGRES_DB=brokerage_db
POSTGRES_USER=brokerage
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_PORT=5432

# SQL generation agent (agent_orchestrator.py, evaluate.py)
ANTHROPIC_API_KEY=

# DeepEval's default LLM judge (evaluate.py) — omit if you wire DeepEval
# to call Claude instead, per EVALUATION.md.
OPENAI_API_KEY=
